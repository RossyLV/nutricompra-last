# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas el archivo ".env" a Git (solo este .env.example).

# Entorno: desarrollo | produccion
ENTORNO=desarrollo

# Modelo preentrenado de Hugging Face para clasificar alimentos
MODELO_HF=nateraw/food

# Archivos de datos en CSV (fáciles de reemplazar por datos reales)
RUTA_CATALOGO=datos/catalogo.csv
RUTA_EQUIVALENCIAS=datos/equivalencias.csv

# Validación de imágenes
TAMANO_MAX_IMAGEN_MB=5

# URL de la API (la usa el dashboard)
URL_API=http://api:8000

# Chat con Microsoft Foundry (la clave real va solo en .env)
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=pon-aqui-tu-clave
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
ID_INDICE_CATALOGO=vs_xxxxxxxx
CHAT_MAX_TOKENS_SALIDA=6000
